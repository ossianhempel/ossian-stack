#!/usr/bin/env bash
set -euo pipefail

# ios-release, manifest-driven helper for the release-ios-app skill.
# Reads the repo-owned .ios-release.env and reports release readiness signals.
# Heavy lifting (build/sign/upload/submit) stays in repo scripts and asc/eas/xcodebuild.

die() { echo "ERROR: $*" >&2; exit 1; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

load_manifest() {
  local root manifest
  root=$(repo_root)
  manifest="$root/.ios-release.env"
  [[ -f "$manifest" ]] || die "No .ios-release.env in $root (is this an iOS app repo with release-ios-app set up?)"
  # shellcheck disable=SC1090
  set -a; source "$manifest"; set +a
  MANIFEST_ROOT="$root"
  : "${IOS_RELEASE_APP_ID:?Set IOS_RELEASE_APP_ID in .ios-release.env}"
  : "${IOS_RELEASE_VERSION_SOURCE:?Set IOS_RELEASE_VERSION_SOURCE in .ios-release.env}"
  IOS_RELEASE_APPSTORE_LOOKUP_COUNTRY=${IOS_RELEASE_APPSTORE_LOOKUP_COUNTRY:-us}
}

# Current marketing version from the version source (project.yml / app.json / app.config.*).
current_version() {
  local src="$MANIFEST_ROOT/$IOS_RELEASE_VERSION_SOURCE"
  [[ -f "$src" ]] || die "Version source not found: $src"
  case "$src" in
    *.json)
      /usr/bin/python3 - "$src" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
v = (d.get("expo") or {}).get("version") or d.get("version")
print(v or "")
PY
      ;;
    *)
      # project.yml / xcconfig style: first MARKETING_VERSION value
      grep -Eo 'MARKETING_VERSION[[:space:]]*[:=][[:space:]]*"?[0-9]+(\.[0-9]+)*"?' "$src" \
        | head -n1 | grep -Eo '[0-9]+(\.[0-9]+)*'
      ;;
  esac
}

# Live App Store version via Apple's public lookup API. Blank only for a valid empty result.
live_version() {
  local json
  json=$(curl -fsS --max-time 15 --get https://itunes.apple.com/lookup \
    --data-urlencode "id=$IOS_RELEASE_APP_ID" \
    --data-urlencode "country=$IOS_RELEASE_APPSTORE_LOOKUP_COUNTRY") || return 1
  printf '%s' "$json" | /usr/bin/python3 -c 'import json
import re
import sys

try:
    data = json.load(sys.stdin)
    results = data["results"]
    count = data["resultCount"]
    if type(count) is not int or not isinstance(results, list) or count != len(results):
        raise ValueError
    if count:
        app = results[0]
        version = app["version"]
        if count != 1 or str(app["trackId"]) != sys.argv[1]:
            raise ValueError
        if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)*", version):
            raise ValueError
        print(version)
except (KeyError, TypeError, ValueError):
    sys.exit("Unexpected App Store lookup response")' "$IOS_RELEASE_APP_ID"
}

valid_version() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)*$ ]]; }

# Compare numeric components. Missing trailing components have value zero.
version_gt() {
  /usr/bin/python3 - "$1" "$2" <<'PYTHON'
from itertools import zip_longest
import sys

current, live = (map(int, version.split(".")) for version in sys.argv[1:])
for left, right in zip_longest(current, live, fillvalue=0):
    if left != right:
        sys.exit(0 if left > right else 1)
sys.exit(1)
PYTHON
}

cmd_live_version() {
  load_manifest
  live_version || die "App Store version lookup unavailable"
}

cmd_status() {
  load_manifest
  local cur live lookup_available=true
  cur=$(current_version || true)
  live=$(live_version) || lookup_available=false
  echo "app:           $IOS_RELEASE_APP_ID  (${IOS_RELEASE_BUNDLE_ID:-?})"
  echo "build system:  ${IOS_RELEASE_BUILD_SYSTEM:-?}"
  echo "version source: $IOS_RELEASE_VERSION_SOURCE"
  echo "branches:      beta=${IOS_RELEASE_BETA_BRANCH:-?} -> release=${IOS_RELEASE_RELEASE_BRANCH:-?}"
  echo "backend:       ${IOS_RELEASE_BACKEND_DEPLOY:-none}"
  echo "current version: ${cur:-<unparsed>}"
  if [[ "$lookup_available" == false ]]; then
    echo "live App Store:  <unavailable>"
    echo "gate:          UNVERIFIED (App Store lookup failed)"
  elif ! valid_version "$cur"; then
    echo "live App Store:  ${live:-<no listing in selected storefront>}"
    echo "gate:          UNVERIFIED (current version could not be parsed)"
  elif [[ -n "$live" ]]; then
    echo "live App Store:  $live"
    if version_gt "$cur" "$live"; then
      echo "gate:          OK ($cur > $live)"
    else
      echo "gate:          BLOCKED ($cur is not > live $live, bump before pushing the release train)"
    fi
  else
    echo "live App Store:  <no listing in selected storefront>"
    echo "gate:          NO LIVE VERSION IN STOREFRONT (verify in App Store Connect)"
  fi
  [[ -n "${IOS_RELEASE_NOTES_FILE:-}" ]] && echo "repo notes:    $IOS_RELEASE_NOTES_FILE (read before release moves)"
  return 0
}

cmd_check_version() {
  load_manifest
  local cur="${1:-}" live
  [[ -n "$cur" ]] || cur=$(current_version || true)
  valid_version "$cur" || die "Could not determine a numeric current version; pass it explicitly"
  live=$(live_version) || die "App Store version lookup unavailable; verify the live version before release"
  if [[ -z "$live" ]]; then
    echo "No live version in the selected storefront. Verify the app ID and live version or first-release status in App Store Connect."
    return 3
  fi
  if version_gt "$cur" "$live"; then
    echo "OK: $cur > live $live"
  else
    die "Version gate failed: $cur is not greater than live App Store version $live"
  fi
}

cmd=${1:-status}; shift || true
case "$cmd" in
  status)        cmd_status "$@" ;;
  check-version) cmd_check_version "$@" ;;
  live-version)  cmd_live_version "$@" ;;
  *)
    cat >&2 <<'EOF'
Usage: ios-release <command>

Commands:
  status                 Show app/build-system/branch/version summary and the version gate.
  check-version [ver]    Require a higher version than the live version. Exit 3 for a valid empty lookup.
  live-version           Print the live App Store version (Apple public lookup).
EOF
    exit 2 ;;
esac
